# URLs limpias para el catálogo público (en producción lo hace Nginx).
<IfModule mod_rewrite.c>
    RewriteEngine On

    # /sitemap.xml -> sitemap.php
    RewriteRule ^sitemap\.xml$ sitemap.php [L]

    # /herramientas y /herramientas/<slug>
    RewriteRule ^tutor/?$ tutor.php [L,QSA]
    RewriteRule ^herramientas/?$ herramientas.php [L,QSA]
    RewriteRule ^herramientas/([a-z0-9-]+)/?$ herramientas.php?h=$1 [L,QSA]
</IfModule>

# Nunca servir estas carpetas ni estos archivos
<IfModule mod_authz_core.c>
    <FilesMatch "^(config\.php|composer\.(json|lock)|install\.php)$">
        Require all denied
    </FilesMatch>
</IfModule>
RedirectMatch 403 ^/(vendor|storage|cron|database)/
